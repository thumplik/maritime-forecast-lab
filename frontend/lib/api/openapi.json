  "info": {
    "description": "Read-only access to canonical AIS datasets. Errors are always `{\"error\": {\"code\", \"message\", \"details\"}}`. Times are UTC; query times must carry an offset.",
    "title": "Maritime Forecast Lab API",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/datasets": {
      "get": {
        "operationId": "datasets_datasets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Datasets",
        "tags": [
          "data"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "meta"
        ]
      }
    },
    "/vessels": {
      "get": {
        "operationId": "vessels_vessels_get",
        "parameters": [
          {
            "description": "Dataset id",
            "in": "query",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "description": "Dataset id",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "title": "Dataset Id",
              "type": "string"
            }
          },
          {
            "description": "Inclusive, UTC offset required",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive, UTC offset required",
              "title": "From"
            }
          },
          {
            "description": "Exclusive, UTC offset required",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive, UTC offset required",
              "title": "To"
            }
          },
          {
            "description": "lon_min,lat_min,lon_max,lat_max",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 100,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "lon_min,lat_min,lon_max,lat_max",
              "title": "Bbox"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 1000000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VesselPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "dataset_not_found / vessel_not_found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "too_many_points"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "invalid_parameter / window_too_large"
          }
        },
        "summary": "Vessels",
        "tags": [
          "data"
        ]
      }
    },
    "/vessels/{vessel_id}/track": {
      "get": {
        "operationId": "track_vessels__vessel_id__track_get",
        "parameters": [
          {
            "in": "path",
            "name": "vessel_id",
            "required": true,
            "schema": {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "title": "Vessel Id",
              "type": "string"
            }
          },
          {
            "description": "Dataset id",
            "in": "query",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "description": "Dataset id",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "title": "Dataset Id",
              "type": "string"
            }
          },
          {
            "description": "Inclusive, UTC offset required",
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Inclusive, UTC offset required",
              "title": "From"
            }
          },
          {
            "description": "Exclusive, UTC offset required",
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Exclusive, UTC offset required",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Track"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "dataset_not_found / vessel_not_found"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "too_many_points"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "invalid_parameter / window_too_large"
          }
        },
        "summary": "Track",
        "tags": [
          "data"
        ]
      }
    }
  }
}
