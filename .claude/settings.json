{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make audit)",
      "Bash(make canonical)",
      "Bash(make calibrate)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(ls:*)",
      "Read(./**)"
    ],
    "deny": [
      "Bash(rm -rf data:*)",
      "Bash(rm -rf ./data:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
